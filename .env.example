# Runtime mode. Demo mode is the only supported mode in Phase 0.
EVENTALPHA_ENV=development
EVENTALPHA_DEMO_MODE=true
EVENTALPHA_LIVE_TRADING_ENABLED=false
EVENTALPHA_KILL_SWITCH=false

# Service addresses
EVENTALPHA_DATABASE_URL=postgresql+psycopg://eventalpha:eventalpha@postgres:5432/eventalpha
EVENTALPHA_REDIS_URL=redis://redis:6379/0
EVENTALPHA_OBJECT_STORAGE_ENDPOINT=

# Optional provider credentials. Leave blank to use replay/demo providers.
OPENAI_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=
NEWS_API_KEY=
FRED_API_KEY=
X_BEARER_TOKEN=
